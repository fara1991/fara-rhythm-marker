<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>FaraRhythmMarker</AssemblyName>
    <RootNamespace>FaraRhythmMarker</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <BeatSaberDir_1_29_1>$(USERPROFILE)\BSManager\BSInstances\1.29.1</BeatSaberDir_1_29_1>
    <BeatSaberDir_1_40_8>$(USERPROFILE)\BSManager\BSInstances\1.40.8</BeatSaberDir_1_40_8>
    <BSVersion Condition="'$(BSVersion)' == ''">1.29.1</BSVersion>
    <CIBuild Condition="'$(CIBuild)' == ''">false</CIBuild>
    <!-- Local build: use Beat Saber installation -->
    <BeatSaberDir Condition="'$(CIBuild)' != 'true' AND '$(BSVersion)' == '1.29.1'">$(BeatSaberDir_1_29_1)</BeatSaberDir>
    <BeatSaberDir Condition="'$(CIBuild)' != 'true' AND '$(BSVersion)' == '1.40.8'">$(BeatSaberDir_1_40_8)</BeatSaberDir>
    <!-- CI build: use Refs folder -->
    <BeatSaberDir Condition="'$(CIBuild)' == 'true'">$(ProjectDir)Refs\$(BSVersion)</BeatSaberDir>
    <LocalRefsDir>$(ProjectDir)Libs</LocalRefsDir>
  </PropertyGroup>

    <PropertyGroup Condition="'$(BSVersion)' == '1.29.1'">
        <DefineConstants>$(DefineConstants);BS_1_29_1</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BSVersion)' == '1.40.8'">
        <DefineConstants>$(DefineConstants);BS_1_40_8</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(BSVersion)' == '1.40.8'">
    <Reference Include="DataModels">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\DataModels.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BGLib.UnityExtension">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\BGLib.UnityExtension.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BGLib.AppFlow">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\BGLib.AppFlow.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BeatSaber.ViewSystem">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- BSIPA -->
    <Reference Include="IPA.Loader">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\IPA.Loader.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Beat Saber Core -->
    <Reference Include="Main">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Main.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameplayCore">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\GameplayCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Core">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BeatmapCore">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\BeatmapCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HMLib">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\HMLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HMUI">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\HMUI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Zenject -->
    <Reference Include="Zenject">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Zenject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zenject-usage">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Zenject-usage.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- SiraUtil (optional but recommended) -->
    <Reference Include="SiraUtil">
      <HintPath>$(BeatSaberDir)\Plugins\SiraUtil.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BSML for UI -->
    <Reference Include="BSML">
      <HintPath>$(BeatSaberDir)\Plugins\BSML.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Views\SettingsView.$(BSVersion).bsml" Condition="Exists('Views\SettingsView.$(BSVersion).bsml')">
      <LogicalName>$(RootNamespace).Views.SettingsView.bsml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Views\SettingsView.1.29.1.bsml" Condition="!Exists('Views\SettingsView.$(BSVersion).bsml')">
      <LogicalName>$(RootNamespace).Views.SettingsView.bsml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="manifest.$(BSVersion).json" Condition="Exists('manifest.$(BSVersion).json')">
      <LogicalName>$(RootNamespace).manifest.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="manifest.json" Condition="!Exists('manifest.$(BSVersion).json')">
      <LogicalName>$(RootNamespace).manifest.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Read version from manifest.json -->
  <Target Name="ReadManifestVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_ManifestFile Condition="Exists('manifest.$(BSVersion).json')">manifest.$(BSVersion).json</_ManifestFile>
      <_ManifestFile Condition="'$(_ManifestFile)' == ''">manifest.json</_ManifestFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_ManifestFile)">
      <Output TaskParameter="Lines" ItemName="_ManifestLines"/>
    </ReadLinesFromFile>
    <PropertyGroup>
      <_ManifestContent>@(_ManifestLines)</_ManifestContent>
      <_ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ManifestContent), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</_ManifestVersion>
      <Version Condition="'$(_ManifestVersion)' != ''">$(_ManifestVersion)</Version>
    </PropertyGroup>
    <Error Condition="'$(_ManifestVersion)' == ''"
           Text="Failed to read version from $(_ManifestFile). Ensure manifest.json contains a valid &quot;version&quot; field."/>
  </Target>

  <!-- Copy to Plugins folder after build (skip in CI and release) -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CIBuild)' != 'true' AND '$(CreateRelease)' != 'true'">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(BeatSaberDir)\Plugins" />
  </Target>

  <!-- Build both versions (skip during release) -->
  <Target Name="BuildAllVersions" AfterTargets="Build" Condition="'$(BuildingMultipleVersions)' != 'true' AND '$(CreateRelease)' != 'true' AND '$(BSVersion)' == '1.29.1'">
    <Message Text="Building for Beat Saber 1.29.1..." Importance="high" />
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Build" Properties="BSVersion=1.29.1;BuildingMultipleVersions=true" />

    <Message Text="Building for Beat Saber 1.40.8..." Importance="high" />
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Build" Properties="BSVersion=1.40.8;BuildingMultipleVersions=true" />

    <Message Text="Both versions built successfully!" Importance="high" />
  </Target>

  <!-- Create release zip (version is read from manifest.json) -->
  <Target Name="CreateRelease" AfterTargets="Build" Condition="'$(CreateRelease)' == 'true' AND '$(BuildingMultipleVersions)' != 'true'">
    <!-- Read version from manifest file -->
    <PropertyGroup>
      <ManifestPath Condition="Exists('$(ProjectDir)manifest.$(BSVersion).json')">$(ProjectDir)manifest.$(BSVersion).json</ManifestPath>
      <ManifestPath Condition="!Exists('$(ProjectDir)manifest.$(BSVersion).json')">$(ProjectDir)manifest.json</ManifestPath>
    </PropertyGroup>
    <ReadLinesFromFile File="$(ManifestPath)">
      <Output TaskParameter="Lines" ItemName="ManifestLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <ManifestContent>@(ManifestLines)</ManifestContent>
      <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($(ManifestContent), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ManifestVersion>
    </PropertyGroup>

    <PropertyGroup>
      <ReleaseDir>$(ProjectDir)..\release</ReleaseDir>
      <ReleaseStagingDir>$(ReleaseDir)\staging</ReleaseStagingDir>
      <ReleaseZipName>FaraRhythmMarker_v$(ManifestVersion).zip</ReleaseZipName>
    </PropertyGroup>

    <!-- Clean staging directory -->
    <RemoveDir Directories="$(ReleaseStagingDir)" />
    <MakeDir Directories="$(ReleaseStagingDir)\1.29.1\Plugins" />
    <MakeDir Directories="$(ReleaseStagingDir)\1.40.8\Plugins" />

    <!-- Build 1.29.1 -->
    <Message Text="[Release] Building for Beat Saber 1.29.1..." Importance="high" />
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Build" Properties="BSVersion=1.29.1;BuildingMultipleVersions=true;CreateRelease=false" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ReleaseStagingDir)\1.29.1\Plugins" />

    <!-- Build 1.40.8 -->
    <Message Text="[Release] Building for Beat Saber 1.40.8..." Importance="high" />
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Build" Properties="BSVersion=1.40.8;BuildingMultipleVersions=true;CreateRelease=false" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ReleaseStagingDir)\1.40.8\Plugins" />

    <!-- Copy SETTINGS_GUIDE.md -->
    <Copy SourceFiles="$(ProjectDir)..\SETTINGS_GUIDE.md" DestinationFolder="$(ReleaseStagingDir)" />

    <!-- Create zip -->
    <Delete Files="$(ReleaseDir)\$(ReleaseZipName)" Condition="Exists('$(ReleaseDir)\$(ReleaseZipName)')" />
    <ZipDirectory SourceDirectory="$(ReleaseStagingDir)" DestinationFile="$(ReleaseDir)\$(ReleaseZipName)" />

    <!-- Clean staging directory -->
    <RemoveDir Directories="$(ReleaseStagingDir)" />

    <Message Text="[Release] Created: release\$(ReleaseZipName)" Importance="high" />
  </Target>

</Project>
