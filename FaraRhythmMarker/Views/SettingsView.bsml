<settings-container>
  <horizontal>
    <text text="FaraRhythmMarker Settings" font-size="5" align="Center"/>
  </horizontal>

  <toggle-setting text="Enabled" value="enabled" apply-on-change="true" hover-hint="Enable or disable the rhythm marker"/>

  <dropdown-list-setting text="Beat Division"
                         value="beat-division"
                         options="beat-division-options"
                         formatter="beat-division-formatter"
                         apply-on-change="true"
                         hover-hint="How many markers per beat"/>

  <horizontal active="~show-beat-division-warning">
    <text text="Using multiple colors is recommended for better visibility when 1/4 or 1/2 beat is selected." color="yellow" align="Center" font-size="3"/>
  </horizontal>

  <dropdown-list-setting text="Color Mode"
                         value="color-mode"
                         options="color-mode-options"
                         formatter="color-mode-formatter"
                         apply-on-change="true"
                         hover-hint="Number of colors to cycle through"/>

  <horizontal>
    <text text="Color Settings" font-size="4"/>
  </horizontal>

  <color-setting text="Color 1" value="color1" hover-hint="First color"/>
  <color-setting text="Color 2" value="color2" hover-hint="Second color (used in 2 and 4 color modes)" apply-on-change="true"/>
  <color-setting text="Color 3" value="color3" hover-hint="Third color (used in 4 color mode)" apply-on-change="true"/>
  <color-setting text="Color 4" value="color4" hover-hint="Fourth color (used in 4 color mode)" apply-on-change="true"/>

  <horizontal>
    <text text="Marker Settings" font-size="4"/>
  </horizontal>

  <slider-setting text="Marker Opacity"
                  value="marker-opacity"
                  min="0.1"
                  max="1.0"
                  increment="0.1"
                  apply-on-change="true"
                  hover-hint="Transparency of the marker"/>

  <slider-setting text="Marker Size"
                  value="marker-size"
                  min="20"
                  max="100"
                  increment="10"
                  apply-on-change="true"
                  hover-hint="Size of the marker in pixels"/>

  <slider-setting text="Flash Duration"
                  value="flash-duration"
                  min="0.01"
                  max="0.2"
                  increment="0.01"
                  apply-on-change="true"
                  hover-hint="How long the marker flash lasts (seconds)"/>

  <horizontal>
    <text text="Position Settings" font-size="4"/>
  </horizontal>

  <slider-setting text="Marker Z Offset"
                  value="marker-z-offset"
                  min="0"
                  max="2"
                  increment="~marker-z-offset-step"
                  apply-on-change="true"
                  hover-hint="Z position offset for markers (adjust for audio latency)"/>

  <dropdown-list-setting text="Z Offset Step"
                         value="marker-z-offset-step-setting"
                         options="z-offset-step-options"
                         formatter="z-offset-step-formatter"
                         apply-on-change="true"
                         hover-hint="Step size when adjusting Z offset"/>
</settings-container>
